<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Intentionally ZERO NuGet package references.
    Everything used here ships with the ASP.NET Core shared framework
    (Microsoft.AspNetCore.App), so `dotnet run` works with only the SDK installed.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExpenseManagement.Api</RootNamespace>
    <AssemblyName>ExpenseManagement.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ExpenseManagement.Api.Tests/**/*.cs" />
    <EmbeddedResource Remove="ExpenseManagement.Api.Tests/**/*.resx" />
    <None Remove="ExpenseManagement.Api.Tests/**/*" />
    <Content Remove="ExpenseManagement.Api.Tests/**/*" />
  </ItemGroup>

</Project>
